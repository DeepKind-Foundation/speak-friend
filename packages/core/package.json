{
  "name": "speak-friend",
  "version": "0.1.0-alpha.3",
  "description": "Headless engine for accessible product tours and onboarding walkthroughs: tours, chapters, steps, roles and progress. No DOM, no React.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DeepKind-Foundation/speak-friend.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/DeepKind-Foundation/speak-friend/issues"
  },
  "homepage": "https://speak-friend.dont-mind-ai.com/",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm build",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "tour",
    "product-tour",
    "guided-tour",
    "onboarding",
    "user-onboarding",
    "walkthrough",
    "accessibility",
    "a11y",
    "wcag",
    "screen-reader",
    "typescript",
    "headless"
  ],
  "publishConfig": {
    "access": "public"
  }
}

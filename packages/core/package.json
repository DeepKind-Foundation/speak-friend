{
  "name": "speak-friend",
  "version": "0.1.0-alpha.1",
  "description": "Headless engine for page tours: tours, chapters, steps, roles and progress. No DOM, no React.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DeepKind-Foundation/speak-friend.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/DeepKind-Foundation/speak-friend/issues"
  },
  "homepage": "https://github.com/DeepKind-Foundation/speak-friend#readme",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "tour",
    "onboarding",
    "walkthrough",
    "accessibility",
    "headless"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "next"
  }
}

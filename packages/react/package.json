{
  "name": "speak-friend-react",
  "version": "0.1.0-alpha.3",
  "description": "Accessible product tours for React: a docked, keyboard-first tour guide with a highlight ring that never dims the page. Screen reader friendly.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DeepKind-Foundation/speak-friend.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/DeepKind-Foundation/speak-friend/issues"
  },
  "homepage": "https://speak-friend.dont-mind-ai.com/",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp src/styles.css dist/styles.css",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "prepublishOnly": "pnpm build",
    "test:coverage": "vitest run --coverage"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "speak-friend": "workspace:*"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.0",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "axe-core": "4.10.3",
    "jsdom": "26.1.0",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "keywords": [
    "tour",
    "product-tour",
    "guided-tour",
    "onboarding",
    "user-onboarding",
    "walkthrough",
    "accessibility",
    "a11y",
    "wcag",
    "screen-reader",
    "typescript",
    "react",
    "react-tour"
  ],
  "publishConfig": {
    "access": "public"
  }
}

{
  "name": "dont-panic-react",
  "version": "0.0.0",
  "description": "React bindings for dont-panic: an accessible docked tour guide with a highlight ring.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DeepKind-Foundation/dont-panic.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/DeepKind-Foundation/dont-panic/issues"
  },
  "homepage": "https://github.com/DeepKind-Foundation/dont-panic#readme",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp src/styles.css dist/styles.css",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "dont-panic": "workspace:*"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.0",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "axe-core": "4.10.3",
    "jsdom": "26.1.0",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "keywords": [
    "tour",
    "onboarding",
    "walkthrough",
    "accessibility",
    "react"
  ]
}

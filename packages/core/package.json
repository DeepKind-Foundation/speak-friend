{
  "name": "dont-panic",
  "version": "0.0.0",
  "description": "Headless engine for page tours: tours, chapters, steps, roles and progress. No DOM, no React.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "tour",
    "onboarding",
    "walkthrough",
    "accessibility",
    "headless"
  ]
}
